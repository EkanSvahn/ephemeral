# Production environment for infra/docker-compose.prod.yml.
#
# Copy to infra/.env on the deployment host and adjust.
# infra/.env is gitignored. Never commit deployment-specific values.

# REQUIRED. There is no safe default, and the compose file refuses to start
# without it. Use the public HTTPS origin the site is served from.
# Separate several origins with commas.
ALLOWED_ORIGINS=https://secrets.example.com

# --- Client address behind the proxy ---
# The API only ever sees connections from the proxy container. With this set,
# it trusts X-Forwarded-For from that network and rate limits each visitor
# separately. Left empty, every visitor shares one rate limit.
# 172.16.0.0/12 covers the address range Docker uses by default. To see the
# network of a running stack:
#   docker network inspect infra_default --format '{{(index .IPAM.Config 0).Subnet}}'
TRUSTED_PROXY_CIDR=172.16.0.0/12

# --- Payload size limits (bytes) ---
# A file is encrypted and base64-encoded in the browser, which makes it about
# a third larger on the wire. The three limits therefore have to grow together:
#   MAX_CIPHERTEXT_BYTES >= MAX_FILE_BYTES * 4/3, plus a little headroom
#   MAX_BODY_BYTES       >  MAX_CIPHERTEXT_BYTES + MAX_META_BYTES + 1024
# The defaults allow 50 MiB files.
MAX_FILE_BYTES=52428800
MAX_CIPHERTEXT_BYTES=83886080
MAX_BODY_BYTES=94371840
MAX_META_BYTES=16384

# Example for 100 MiB files. Every stored secret lives in Redis memory until it
# is opened or expires, so size the host accordingly.
#   MAX_FILE_BYTES=104857600
#   MAX_CIPHERTEXT_BYTES=146800640
#   MAX_BODY_BYTES=157286400

# File types that may be uploaded. Each entry is matched exactly against the
# type the browser reports.
ALLOWED_FILE_MIME_TYPES=application/pdf,image/png,image/jpeg,text/plain,application/octet-stream

# To also accept JSON and common archive formats:
#   ALLOWED_FILE_MIME_TYPES=application/pdf,image/png,image/jpeg,text/plain,application/octet-stream,application/json,application/zip,application/x-rar-compressed,application/vnd.rar,application/x-7z-compressed,application/gzip,application/x-tar

# --- Lifetime and view limits ---
MAX_TTL_SECONDS=86400
MAX_VIEWS=100
ID_LENGTH_BYTES=24

# Upper bound for one request. Large uploads on slow connections need the
# time, so keep this at 60 seconds or more when files are allowed.
REQUEST_TIMEOUT_MS=60000

# --- Rate limits, per client address and endpoint ---
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=20

# --- Security policy ---
# REQUIRE_PASSWORD=true rejects secrets whose key travels in the link. Only
# password-derived keys are accepted. Recommended for deployments inside an
# organization. The frontend has to be built with the same value.
REQUIRE_PASSWORD=true
VITE_REQUIRE_PASSWORD=true

# Refuse to start if Redis has persistence enabled (appendonly or RDB save).
STRICT_REDIS_EPHEMERAL=true

# Serves Prometheus counters on /api/metrics. The endpoint has no
# authentication, so leave it off unless the proxy restricts who can reach it.
METRICS_ENABLED=false

# --- Frontend build ---
# Where the /code link in the navigation points. A fork sets its own
# repository here. Changing it requires rebuilding the web image.
# VITE_CODE_URL=https://github.com/your-name/your-fork
